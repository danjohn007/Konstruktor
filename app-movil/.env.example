# Copia este archivo como .env.local y pon la dirección del sistema web.
# Es el servidor que aparece de entrada en el login (se puede cambiar ahí con "Cambiar servidor").
#   Emulador de Android con el sistema en tu PC:  http://10.0.2.2:8085
#   Teléfono en la misma red Wi-Fi que tu PC:      http://192.168.x.x:8085
#   Producción (para las tiendas, siempre HTTPS):  https://konstruktor.com.mx/panel
EXPO_PUBLIC_API_URL=https://konstruktor.com.mx/panel

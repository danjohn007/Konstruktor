# La landing (carpeta de arriba) usa index.html; el sistema, index.php.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Forzar HTTPS, como la landing (sus reglas no aplican dentro de esta carpeta). En la PC local no.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    # Algunos hostings (PHP como CGI/FastCGI) no pasan el encabezado Authorization a PHP; la app lo necesita.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
